# Copy this file to .env and fill in your real values.
# Once you have a real .env, it's gitignored — you won't need to re-enter
# these every time you pull an update.

DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/satin_and_seal
JWT_SECRET_KEY=change-this-to-a-long-random-string
FLASK_ENV=development

# Real admin account created by seed.py — change these to your actual details.
ADMIN_NAME=Store Admin
ADMIN_EMAIL=asugo27@gmail.com
ADMIN_PASSWORD=123Enter$
ADMIN_PHONE=0700000000

# --- Password reset emails ---
# If left blank, reset links print to the server console instead (fine for
# local testing). Fill these in with a real SMTP provider before launch.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@yourdomain.co.ke
FRONTEND_URL=http://localhost:5173

# --- SasaPay callback ---
# Must be a URL SasaPay's servers can actually reach — localhost won't work.
# For local testing, use a tunnel like ngrok and put its https URL here.
APP_BASE_URL=http://localhost:5000
